rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.tier == 'superadmin' ||
        request.auth.token.tier == 'company'
      );
    }

    // Default: require authentication
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // ─── Client-specific deliverables and invoices ───────────────────
    match /deliverables/{deliverableId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.tier != 'client';
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.tier != 'client';
    }

    // ─── Client Onboarding & Compliance Documents ────────────────────
    match /clientOnboarding/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ─── Attendance & Timeline ────────────────────────────────────────
    match /attendanceLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /workTimelineEntries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Announcements (read: all employees; write: admins only) ─────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Company Calendar (read: all employees; write: admins only) ──
    match /companyCalendar/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Company Holidays (admin-marked; read: all employees) ────────
    match /companyHolidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ─── Employee Documents (private to each employee) ───────────────
    // Employees upload/read their own; admins can read all
    match /documents/{uid}/files/{docId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ─── Payslips (admin writes; employee reads own only) ────────────
    match /payslips/{uid}/records/{payslipId} {
      allow read: if isOwner(uid);
      allow write: if isAdmin();
    }

    // ─── Goals (private to each employee) ────────────────────────────
    match /goals/{uid}/items/{goalId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Help Desk Tickets (clients, project employees, and admins) ─
    match /helpDeskTickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }


    // ─── Notifications (private to each user) ────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
  }
}
